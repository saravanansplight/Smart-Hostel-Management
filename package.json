{
  "name": "smart-hostel-management-system",
  "version": "1.0.0",
  "description": "Responsive full-stack hostel administration portal for students and wardens",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:test": "node scripts/test-db-connection.js",
    "css:build": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --watch"
